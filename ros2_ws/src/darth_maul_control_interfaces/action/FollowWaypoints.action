# Goal
# Execute metric waypoints in a fixed frame.
geometry_msgs/PoseStamped[] waypoints

# Optional final heading behavior.
bool use_final_heading
float64 final_heading_rad

# Goal tolerances.
float64 position_tolerance_m
float64 heading_tolerance_rad

# Per-goal velocity limits. Implementation must also enforce package-level hard limits.
float64 max_linear_x_mps
float64 max_linear_y_mps
float64 max_angular_z_radps

# Zero duration means implementation default.
builtin_interfaces/Duration timeout
---
# Result
bool success

uint8 RESULT_SUCCESS=0
uint8 RESULT_CANCELED=1
uint8 RESULT_TIMEOUT=2
uint8 RESULT_INVALID_GOAL=3
uint8 RESULT_ODOM_UNAVAILABLE=4
uint8 RESULT_CONTROL_FAILED=5

uint8 result_code
string message

geometry_msgs/PoseStamped final_pose
float64 final_position_error_m
float64 final_heading_error_rad
---
# Feedback
uint32 active_waypoint_index
uint32 waypoint_count

geometry_msgs/PoseStamped current_pose
float64 distance_to_active_waypoint_m
float64 heading_error_rad

string status
